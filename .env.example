NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=
ADMIN_EMAILS=
NEXT_PUBLIC_ADMIN_EMAILS=
REMINDER_WINDOW_MINUTES=30
RESEND_API_KEY=
# Testing: Health Monitor <onboarding@resend.dev>. Replace with your verified domain before a campaign.
EMAIL_FROM=Health Monitor <onboarding@resend.dev>
# Must be the email address on your Resend account while using the test sender.
EMAIL_TEST_TO=
# Public production URL, for example https://health-monitor-amber.vercel.app
EMAIL_PUBLIC_URL=
# Dedicated random secret, at least 32 characters; separate from CRON_SECRET.
EMAIL_UNSUBSCRIBE_SECRET=
# Keep the previous secret during rotation so existing unsubscribe links work.
EMAIL_UNSUBSCRIBE_PREVIOUS_SECRET=

# Legacy Supabase projects may show this as anon key instead of publishable key.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
